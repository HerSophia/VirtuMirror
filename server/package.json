{
  "name": "phone-bridge-server",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "esbuild index.ts --bundle --platform=node --outfile=dist/server.js --format=esm --external:express --external:socket.io --external:cors",
    "build:standalone": "esbuild index.ts --bundle --platform=node --outfile=dist/server.cjs --format=cjs",
    "start": "node dist/server.js",
    "pkg": "npm run build:standalone && pkg dist/server.cjs -t node18-win-x64,node18-macos-x64,node18-linux-x64 -o dist/phone-bridge"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "esbuild": "^0.19.8",
    "pkg": "^5.8.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2"
  }
}
